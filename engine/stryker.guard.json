{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/api/schema/stryker-core.json",
  "testRunner": "command",
  "mutate": [
    "src/goahead.ts"
  ],
  "coverageAnalysis": "off",
  "reporters": [
    "html",
    "json",
    "clear-text"
  ],
  "htmlReporter": {
    "fileName": "out/guard-mutation/index.html"
  },
  "jsonReporter": {
    "fileName": "out/guard-mutation/mutation.json"
  },
  "plugins": [],
  "inPlace": true,
  "commandRunner": {
    "command": "npx vitest run --config vitest.guard.config.ts --reporter=dot"
  },
  "concurrency": 4
}
