# Set default behavior to automatically normalize line endings
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout
*.ts text
*.js text
*.json text
*.md text
*.yml text
*.yaml text

# Node scripts start with a #! line, and a CR at its end breaks importing them
# under Vitest on a Windows checkout (#94). Keep them LF everywhere.
*.mjs text eol=lf
*.cjs text eol=lf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.pdf binary
