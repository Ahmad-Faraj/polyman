{
  "description": "A second provider in the pool the deployer trusts, with another issuer and no condition: any token that issuer signs could deploy",
  "expect": "wif-condition",
  "ops": [
    {
      "op": "add_resource",
      "resource": {
        "address": "google_iam_workload_identity_pool_provider.other",
        "mode": "managed",
        "type": "google_iam_workload_identity_pool_provider",
        "name": "other",
        "provider_name": "registry.opentofu.org/hashicorp/google",
        "values": {
          "workload_identity_pool_id": "gitlab",
          "workload_identity_pool_provider_id": "other",
          "attribute_condition": "",
          "oidc": [{ "issuer_uri": "https://token.example.com" }]
        }
      }
    }
  ]
}
