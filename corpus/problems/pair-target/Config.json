{
  "$schema": "./Config.schema.json",
  "name": "pair-target",
  "description": "Corpus problem: any valid pair is accepted, so it needs a special checker. True verdicts of its mutants are pinned in corpus/expected.",

  "timeLimit": 2000,
  "memoryLimit": 256,
  "inputFile": "stdin",
  "outputFile": "stdout",
  "interactive": false,

  "tags": ["data structures", "hashing"],

  "statements": {
    "english": {
      "encoding": "UTF-8",
      "name": "Pair for a Target",
      "legend": "./statements/english/legend.tex",
      "input": "./statements/english/input-format.tex",
      "output": "./statements/english/output-format.tex",
      "notes": "./statements/english/notes.tex"
    }
  },

  "solutions": [
    {
      "name": "main",
      "source": "./solutions/acc.cpp",
      "tag": "MA",
      "sourceType": "cpp.g++17"
    },
    {
      "name": "ok_two_pointers",
      "source": "./solutions/ok_two_pointers.cpp",
      "tag": "OK",
      "sourceType": "cpp.g++17"
    },
    {
      "name": "ok_python",
      "source": "./solutions/ok_python.py",
      "tag": "OK",
      "sourceType": "python.3"
    },
    {
      "name": "ok_java",
      "source": "./solutions/ok_java.java",
      "tag": "OK",
      "sourceType": "java.11"
    },
    {
      "name": "wa_same_index",
      "source": "./solutions/wa_same_index.cpp",
      "tag": "WA",
      "sourceType": "cpp.g++17"
    },
    {
      "name": "wa_adjacent",
      "source": "./solutions/wa_adjacent.py",
      "tag": "WA",
      "sourceType": "python.3"
    },
    {
      "name": "pe_one_index",
      "source": "./solutions/pe_one_index.cpp",
      "tag": "PE",
      "sourceType": "cpp.g++17"
    },
    {
      "name": "re_off_by_one",
      "source": "./solutions/re_off_by_one.py",
      "tag": "RE",
      "sourceType": "python.3"
    }
  ],

  "generators": [
    {
      "name": "gen",
      "source": "./generators/gen.cpp"
    }
  ],

  "checker": {
    "name": "pair_checker",
    "source": "./checker/chk.cpp",
    "testsFilePath": "./checker/checker_tests.json",
    "isStandard": false
  },

  "validator": {
    "name": "validator",
    "source": "./validator/val.cpp",
    "testsFilePath": "./validator/validator_tests.json"
  },

  "testsets": [
    {
      "name": "tests",
      "generatorScript": {
        "scriptFile": "./generators/gen-script.txt"
      },
      "manualTests": [
        {
          "input": "./manual/tests/m-01-sample.in",
          "index": 1,
          "group": "samples",
          "useInStatements": true
        }
      ],
      "groupsEnabled": true,
      "groups": [
        { "name": "samples" },
        { "name": "main" }
      ]
    }
  ]
}
