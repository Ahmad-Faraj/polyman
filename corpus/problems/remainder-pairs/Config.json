{
  "$schema": "./Config.schema.json",
  "name": "remainder-pairs",
  "description": "Corpus problem: a time limit that Java and Python solutions must respect. Linear solutions in C++, Java and Python pass; quadratic ones in Java and Python must get TLE. True verdicts are pinned in corpus/expected.",

  "timeLimit": 2000,
  "memoryLimit": 256,
  "inputFile": "stdin",
  "outputFile": "stdout",
  "interactive": false,

  "tags": ["math", "combinatorics"],

  "statements": {
    "english": {
      "encoding": "UTF-8",
      "name": "Pairs Divisible by k",
      "legend": "./statements/english/legend.tex",
      "input": "./statements/english/input-format.tex",
      "output": "./statements/english/output-format.tex",
      "notes": "./statements/english/notes.tex"
    }
  },

  "solutions": [
    {
      "name": "main",
      "source": "./solutions/acc.cpp",
      "tag": "MA",
      "sourceType": "cpp.g++17"
    },
    {
      "name": "ok_java",
      "source": "./solutions/ok_java.java",
      "tag": "OK",
      "sourceType": "java21"
    },
    {
      "name": "ok_python",
      "source": "./solutions/ok_python.py",
      "tag": "OK",
      "sourceType": "python.3"
    },
    {
      "name": "tl_java_quadratic",
      "source": "./solutions/tl_java_quadratic.java",
      "tag": "TL",
      "sourceType": "java21"
    },
    {
      "name": "tl_python_quadratic",
      "source": "./solutions/tl_python_quadratic.py",
      "tag": "TL",
      "sourceType": "python.3"
    },
    {
      "name": "wa_int_overflow",
      "source": "./solutions/wa_int_overflow.java",
      "tag": "WA",
      "sourceType": "java21"
    },
    {
      "name": "wa_half_residue",
      "source": "./solutions/wa_half_residue.cpp",
      "tag": "WA",
      "sourceType": "cpp.g++17"
    }
  ],

  "generators": [
    {
      "name": "gen",
      "source": "./generators/gen.cpp"
    }
  ],

  "checker": {
    "name": "ncmp",
    "source": "ncmp.cpp",
    "isStandard": true
  },

  "validator": {
    "name": "validator",
    "source": "./validator/val.cpp",
    "testsFilePath": "./validator/validator_tests.json"
  },

  "testsets": [
    {
      "name": "tests",
      "generatorScript": {
        "scriptFile": "./generators/gen-script.txt"
      },
      "manualTests": [
        {
          "input": "./manual/tests/m-01-sample.in",
          "index": 1,
          "group": "samples",
          "useInStatements": true
        }
      ],
      "groupsEnabled": true,
      "groups": [
        { "name": "samples" },
        { "name": "main" }
      ]
    }
  ]
}
