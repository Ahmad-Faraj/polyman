{
  "$schema": "./Config.schema.json",
  "name": "sum-parity",
  "description": "Corpus problem: polyman's own template plus mutant solutions whose verdicts are pinned in corpus/expected.",

  "timeLimit": 1000,
  "memoryLimit": 256,
  "inputFile": "stdin",
  "outputFile": "stdout",
  "interactive": false,

  "tags": ["implementation", "math"],

  "statements": {
    "english": {
      "encoding": "UTF-8",
      "name": "My Problem Template",
      "legend": "./statements/english/legend.tex",
      "input": "./statements/english/input-format.tex",
      "output": "./statements/english/output-format.tex",
      "notes": "./statements/english/notes.tex"
    },
    "russian": {
      "encoding": "UTF-8",
      "name": "Шаблон моей проблемы",
      "legend": "./statements/russian/legend.tex",
      "input": "./statements/russian/input-format.tex",
      "output": "./statements/russian/output-format.tex",
      "notes": "./statements/russian/notes.tex"
    }
  },

  "solutions": [
    {
      "name": "main",
      "source": "./solutions/acc.cpp",
      "tag": "MA",
      "sourceType": "cpp.g++17"
    },
    {
      "name": "correct2",
      "source": "./solutions/acc2.java",
      "tag": "OK",
      "sourceType": "java.11"
    },
    {
      "name": "tle_solution",
      "source": "./solutions/tle.py",
      "tag": "TL",
      "sourceType": "python.3"
    },
    {
      "name": "ok_python",
      "source": "./solutions/ok_python.py",
      "tag": "OK",
      "sourceType": "python.3"
    },
    {
      "name": "wa_always_yes",
      "source": "./solutions/wa_always_yes.cpp",
      "tag": "WA",
      "sourceType": "cpp.g++17"
    },
    {
      "name": "wa_skips_last",
      "source": "./solutions/wa_skips_last.cpp",
      "tag": "WA",
      "sourceType": "cpp.g++17"
    },
    {
      "name": "wa_python",
      "source": "./solutions/wa_python.py",
      "tag": "WA",
      "sourceType": "python.3"
    },
    {
      "name": "re_abort",
      "source": "./solutions/re_abort.cpp",
      "tag": "RE",
      "sourceType": "cpp.g++17"
    },
    {
      "name": "pe_prints_sum",
      "source": "./solutions/pe_prints_sum.cpp",
      "tag": "PE",
      "sourceType": "cpp.g++17"
    },
    {
      "name": "tl_spins",
      "source": "./solutions/tl_spins.cpp",
      "tag": "TL",
      "sourceType": "cpp.g++17"
    }
  ],

  "generators": [
    {
      "name": "gen-random",
      "source": "./generators/gen.cpp"
    }
  ],

  "checker": {
    "name": "custom_checker",
    "source": "./checker/chk.cpp",
    "testsFilePath": "./checker/checker_tests.json",
    "isStandard": false
  },

  "validator": {
    "name": "validator",
    "source": "./validator/val.cpp",
    "testsFilePath": "./validator/validator_tests.json"
  },

  "testsets": [
    {
      "name": "tests",
      "generatorScript": {
        "scriptFile": "./generators/gen-script.txt"
      },
      "manualTests": [
        {
          "input": "./manual/tests/m-01-sample.in",
          "index": 1,
          "group": "samples",
          "useInStatements": true
        }
      ],
      "groupsEnabled": true,
      "groups": [
        { "name": "samples" },
        { "name": "main" }
      ]
    }
  ]
}
